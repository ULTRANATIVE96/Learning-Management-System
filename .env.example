# myTutor Frontend Environment Configuration
# Copy this file to '.env' if you want to change the defaults.
# NONE of these are required — with no .env the app runs fully serverless
# (perfect for Vercel): data in localStorage, files/videos in IndexedDB.

# ---- Live class realtime relay (chat + WebRTC signaling between devices) ----
# Public MQTT-over-WebSocket broker used to connect lecturer and students.
# Default: wss://broker.emqx.io:8084/mqtt   Set to "off" to only sync tabs in the same browser.
# VITE_MQTT_URL=wss://broker.emqx.io:8084/mqtt

# Unique channel name for your deployment (keeps your classes separate from other deployments).
# VITE_REALTIME_NAMESPACE=mytutor-divine-university

# ---- Optional: legacy Spring Boot backend (NOT needed for Vercel) ----
# Only used when VITE_USE_BACKEND=true.
# VITE_USE_BACKEND=false
# VITE_API_URL=http://localhost:8080/api
# VITE_API_WS_URL=localhost:8080
